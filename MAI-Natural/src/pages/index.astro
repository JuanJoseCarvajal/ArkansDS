---
import BaseLayout from '../layouts/BaseLayout.astro';
import { bestSellers, brand, categories } from '../data/content';
---

<BaseLayout title="MAI Natural | Alquimia viva para tu piel">
  <section class="hero">
    <p class="eyebrow">Cosmética Natural Orgánica</p>
    <h1>Despierta tu piel con el poder de la tierra.</h1>
    <p>Descubre la alquimia natural de MAI: fórmulas botánicas que respetan tu piel y potencian resultados visibles.</p>
    <div class="actions">
      <a class="btn" href="/tienda">Descubrir productos</a>
      <a class="btn secondary" href="/agenda-tu-cita">Agenda tu cita</a>
    </div>
  </section>

  <section>
    <h2>Líneas de cuidado</h2>
    <div class="cards">
      {categories.map((category) => (
        <article class="card">
          <h3>{category.title}</h3>
          <p>{category.description}</p>
          <a href={category.href}>Explorar línea →</a>
        </article>
      ))}
    </div>
  </section>

  <section>
    <h2>Más vendidos</h2>
    <div class="cards">
      {bestSellers.map((item) => (
        <article class="card product">
          <p class="tag">{item.category}</p>
          <h3>{item.name}</h3>
          <p>{item.benefit}</p>
          <strong>{item.price}</strong>
        </article>
      ))}
    </div>
  </section>

  <section class="cta">
    <h2>Asesoramiento alquímico: piel a piel.</h2>
    <p>En MAI cada fórmula nace de escuchar tu historia, tu energía y las necesidades reales de tu piel.</p>
    <a class="btn" href={brand.whatsapp} target="_blank" rel="noreferrer">Ven, hablemos</a>
  </section>
</BaseLayout>
